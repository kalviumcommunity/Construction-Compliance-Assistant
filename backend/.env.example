# ==============================================================================
# SiteSafe Construction Regulatory Compliance Assistant - Environment Configuration
# ==============================================================================

# LLM & Embeddings Provider (Optional)
# Recommended: Set GEMINI_API_KEY for Google Gemini (e.g. gemini-3.6-flash)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-3.6-flash
# Optional: Set EMBEDDING_PROVIDER to 'fastembed' (default 384d, local & free), 'gemini' (768d), or 'openai' (1536d)
EMBEDDING_PROVIDER=fastembed

# Alternative: OpenAI Provider
# OPENAI_API_KEY=
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Configuration (Qdrant)
QDRANT_COLLECTION=construction_compliance
# Remote Qdrant cluster (leave empty for local embedded persistent storage at backend/qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=

# Document Ingestion Security & Authorization
# Required for POST /api/ingest/upload and POST /api/reindex
INGEST_API_KEY=change-to-your-secure-admin-token

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed CORS origins (avoid '*' in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
