# ==============================================================================
# SiteSafe Construction Compliance Assistant - Environment Configuration
# Copy this file to .env (or backend/.env) and populate environment variables.
# NEVER COMMIT REAL API KEYS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 2. Security & Rate Limiting Configuration
# ------------------------------------------------------------------------------
INGEST_API_KEY=sitesafe-admin-key-2026
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_VERIFY_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 3. Vector Store Configuration (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_COLLECTION=construction_compliance
# Local embedded vector storage path (used when QDRANT_URL is empty)
QDRANT_PATH=backend/qdrant_storage
# Remote Qdrant server URL (optional, e.g. http://localhost:6333 or cloud URL)
QDRANT_URL=
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. LLM & Embedding Model Configuration
# ------------------------------------------------------------------------------
# Embedding Provider Choice: "fastembed" (100% offline local), "gemini", or "openai"
EMBEDDING_PROVIDER=fastembed

# Local FastEmbed Models
FASTEMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25

# Gemini API Configuration (Optional - for cloud Gemini LLM & embeddings)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI API Configuration (Optional - for OpenAI LLM & embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. RAG Pipeline & Guardrails Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
TIKTOKEN_ENCODING=o200k_base
RAG_RELEVANCE_THRESHOLD=0.01
MIN_RELEVANT_CHUNKS=1

# ------------------------------------------------------------------------------
# 6. Caching, Structured Logging & Cost Monitoring Settings
# ------------------------------------------------------------------------------
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600
RAG_LOG_FORMAT=json
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.00060

# ------------------------------------------------------------------------------
# 7. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_INGEST_API_KEY=sitesafe-admin-key-2026
